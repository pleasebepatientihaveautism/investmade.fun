{
  "name": "investmade.fun",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:server": "tsx watch src/server/index.ts",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production tsx src/server/index.ts",
    "lint": "biome lint src tests scripts",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:uniswap": "node scripts/verify-uniswap.mjs",
    "db:migrate": "node scripts/migrate.mjs"
  },
  "dependencies": {
    "@fontsource/archivo-black": "^5.2.6",
    "@fontsource/dm-sans": "^5.2.6",
    "@privy-io/node": "0.27.0",
    "@privy-io/react-auth": "3.35.2",
    "@worldcoin/idkit-core": "^4.0.11",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "viem": "2.55.5",
    "zod": "^4.0.10"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.1.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.3",
    "typescript": "~5.8.3",
    "vite": "^7.0.6",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "axios": "1.18.1",
    "uuid": "14.0.1",
    "ws": "8.21.1"
  }
}

# Local demo: deterministic fixtures, never broadcast.
INVESTMADE_DEMO_MODE=true
# Local development only: fetch real quotes and ask the Privy Investmade smart wallet to sign one atomic basket.
# Privy Dashboard must enable smart wallets and custom chain 4663 with an Alchemy bundler/paymaster.
# Never enable this in production; full production mode remains INVESTMADE_DEMO_MODE=false.
LOCAL_LIVE_EXECUTION=false
PORT=8787
PUBLIC_ORIGIN=http://localhost:5173
SESSION_SECRET=replace-with-at-least-32-random-characters
PRIVY_APP_ID=replace-with-privy-app-id
PRIVY_APP_SECRET=replace-with-privy-app-secret

# Required when INVESTMADE_DEMO_MODE=false.
DATABASE_URL=postgresql://user:password@localhost:5432/investmade_fun
ZERO_EX_API_KEY=
UNISWAP_API_KEY=
JUPITER_API_KEY=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com
# Optional user-run verifier inputs. The first symbol should already be held for the reverse simulation.
ZERO_EX_VERIFY_WALLET=
ZERO_EX_VERIFY_TX_ORIGIN=
ZERO_EX_VERIFY_SYMBOLS=AAPL,TSLA
# Optional CoinGecko Demo API key for higher limits. Keep it server-side; never prefix it with VITE_.
COINGECKO_API_KEY=
ZG_ROUTER_API_KEY=
# Production: https://robinhood-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

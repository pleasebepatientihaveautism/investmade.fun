# Local demo: deterministic fixtures, never broadcast.
INVESTMADE_DEMO_MODE=true
PORT=8787
PUBLIC_ORIGIN=http://localhost:5173
SESSION_SECRET=replace-with-at-least-32-random-characters
PRIVY_APP_ID=replace-with-privy-app-id
PRIVY_APP_SECRET=replace-with-privy-app-secret

# Required when INVESTMADE_DEMO_MODE=false.
DATABASE_URL=postgresql://user:password@localhost:5432/investmade_fun
UNISWAP_API_KEY=
ZG_ROUTER_API_KEY=
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_RP_SIGNING_KEY=
WORLD_ACTION=investmade.fun-human-v1
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Optional. Stock cards fail closed unless this server-side service confirms
# jurisdiction/product eligibility for the authenticated wallet.
STOCK_ELIGIBILITY_PROVIDER_URL=
STOCK_ELIGIBILITY_API_KEY=
